# Copy to .env (never commit it) or export these in your shell. Read-only scopes are enough.

# Meta: a system-user or user token with ads_read
META_ACCESS_TOKEN=

# LinkedIn: a Marketing Developer Platform token with r_ads and r_ads_reporting
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# Google Ads: developer token + OAuth client + refresh token with the adwords scope
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only when you reach accounts through a manager (MCC) account:
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
