{
  "name": "ad-preflight",
  "version": "0.1.2",
  "description": "Meta Ads, Google Ads and LinkedIn Ads MCP server and CLI for pre-launch campaign audits: checks bid, destination, approval, geo, spend cap and landing page before you spend, plus spend reconciliation. Read-only.",
  "type": "module",
  "bin": {
    "ad-preflight": "bin/ad-preflight.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "meta ads",
    "facebook ads",
    "linkedin ads",
    "google ads",
    "mcp",
    "mcp-server",
    "ads",
    "ppc",
    "marketing",
    "preflight",
    "audit",
    "claude-code",
    "spend",
    "meta ads mcp",
    "google ads mcp",
    "facebook ads mcp",
    "linkedin ads mcp",
    "google ads audit",
    "ppc audit",
    "ad audit",
    "meta ads api"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GroMarketing/ad-preflight.git"
  },
  "homepage": "https://github.com/GroMarketing/ad-preflight#readme",
  "bugs": {
    "url": "https://github.com/GroMarketing/ad-preflight/issues"
  },
  "author": "Ro Maldonado"
}
